<RCC>
  <qresource prefix="/icons">
      <file alias="alt-limit-off.svg">../icons/turtle-silhouette.svg</file>
      <file alias="alt-limit-on.svg">../icons/turtle.svg</file>
      <file alias="encrypted.svg">../icons/lock.svg</file>
      <file alias="hamburger-menu.svg">../icons/hamburger-menu.svg</file>
      <file alias="ratio.svg">../icons/yin-yang.svg</file>
      <file alias="transmission.svg">../icons/hicolor_apps_scalable_transmission.svg</file>
  </qresource>
  <qresource prefix="/themes">
      <file alias="modern.qss">themes/modern.qss</file>
      <file alias="check.svg">themes/check.svg</file>
      <file alias="check-black.svg">themes/check-black.svg</file>
      <file alias="check-text-light.svg">themes/check-text-light.svg</file>
      <file alias="chevron-down.svg">themes/chevron-down.svg</file>
      <file alias="chevron-up.svg">themes/chevron-up.svg</file>
      <file alias="dash.svg">themes/dash.svg</file>
      <file alias="dash-black.svg">themes/dash-black.svg</file>
      <file alias="dot.svg">themes/dot.svg</file>
      <file alias="dot-black.svg">themes/dot-black.svg</file>
  </qresource>
</RCC>
